#!/bin/bash
# Pre-commit hook: build only, show last test results

REPO_ROOT="$(git rev-parse --show-toplevel)"
BUILD_DIR="$REPO_ROOT/tests/build"
TEST_REPORT="$BUILD_DIR/last_test_report.txt"

echo "=== Pre-commit: Building tests ==="
BUILD_OUTPUT=$(ninja -C "$BUILD_DIR" TrackerTests 2>&1)
BUILD_RC=$?
echo "$BUILD_OUTPUT" | tail -5
if [ $BUILD_RC -ne 0 ]; then
    echo "ERROR: Build failed. Commit aborted."
    exit 1
fi

if [ -f "$TEST_REPORT" ]; then
    echo "=== Last test run ==="
    cat "$TEST_REPORT"
else
    echo "=== No test report found. Run: cd tests/build && ./TrackerTests ==="
fi

# Templates: they are pushed to sealed devices, and a drifted one is only
# discovered in the field. Cheap enough to run every time; it needs no
# hardware. PYLINKIT, when set, lets it use PyLinkit's own encoder.
if git diff --cached --name-only | grep -qE '^(template_conf/|core/protocol/dte_params\.cpp|tools/pylinkit_map\.py)'; then
    echo "=== Pre-commit: Checking deployment templates ==="
    if ! python3 "$REPO_ROOT/tools/check_template_conf.py"; then
        echo "ERROR: a template no longer matches the parameter table. Commit aborted."
        exit 1
    fi
fi

# Bench: une chaine de log cherchee mais absente du firmware est silencieuse
# dans le pire sens — le cas passe (ou echoue) pour une raison etrangere au
# firmware. Trois faux resultats en une journee sont venus de la.
if git diff --cached --name-only | grep -qE '^(tests/bench/|core/|ports/nrf52840/core/)'; then
    echo "=== Pre-commit: Checking bench log patterns ==="
    if ! python3 "$REPO_ROOT/tools/check_bench_log_patterns.py"; then
        echo "ERROR: a bench case greps for a log line the firmware does not emit. Commit aborted."
        exit 1
    fi
fi

# Le firmware parle anglais. Le 2026-08-31 un utilisateur a recu un journal de
# sa balise ou six messages sur dix etaient en francais; ces journaux partent
# chez des partenaires. Le harnais de banc, lui, reste en francais et n est pas
# verifie.
if git diff --cached --name-only | grep -qE '^(core/|ports/nrf52840/(core/|main\.cpp|bsp/))'; then
    echo "=== Pre-commit: Checking firmware logs are English ==="
    if ! python3 "$REPO_ROOT/tools/check_english_logs.py"; then
        echo "ERROR: a firmware log string is in French. Commit aborted."
        exit 1
    fi
fi

# SMP01 (ARGOS_CACHED_MODULATION) a un seul ecrivain: un ecrivain direct
# sauterait la tenue de ART13/ART14 et laisserait un cache perime "de
# confiance" pour toujours. Les pilotes concernes n ont aucun test hote.
if git diff --cached --name-only | grep -qE '^(core/|ports/nrf52840/|tests/)'; then
    echo "=== Pre-commit: Checking ARGOS_CACHED_MODULATION has one writer ==="
    if ! python3 "$REPO_ROOT/tools/check_cached_modulation_writes.py"; then
        echo "ERROR: ARGOS_CACHED_MODULATION written outside its helper. Commit aborted."
        exit 1
    fi
fi

# La garde de batterie critique est le seul chemin qui appelle PMU::powerdown()
# sur une balise scellee. Elle a existe en deux copies qui ont diverge jusqu au
# terrain; il n y en a plus qu une, et aucun test hote ne peut verifier que les
# services l APPELLENT encore (is_lb depend d un drapeau que le faux magasin de
# configuration ne rafraichit jamais).
if git diff --cached --name-only | grep -qE '^core/services/(service|.*_tx_service)\.cpp$'; then
    echo "=== Pre-commit: Checking every TX service calls the battery guard ==="
    if ! python3 "$REPO_ROOT/tools/check_battery_guard_callers.py"; then
        echo "ERROR: the critical-battery guard is not wired as expected. Commit aborted."
        exit 1
    fi
fi

# Cliquet de complexite: aucune fonction ne devient plus complexe qu elle n est
# deja. La garde naive -- moins d avertissements lizard qu avant -- est pire que
# rien: decouper handle_line() a fait tomber sa pire fonction de CCN 118 a 12 et
# monter le fichier de 4 a 8 avertissements. Ici c est le CCN de chaque fonction
# qui est epingle. lizard est optionnel en local; la CI reste la vraie barriere.
if git diff --cached --name-only | grep -qE '^(core/|ports/nrf52840/(core/|main\.cpp))'; then
    if command -v lizard >/dev/null 2>&1; then
        echo "=== Pre-commit: Checking no function got more complex ==="
        if ! python3 "$REPO_ROOT/tools/check_complexity_ratchet.py"; then
            echo "ERROR: a function got more complex. Commit aborted."
            exit 1
        fi
    fi
fi

echo "=== Pre-commit: Build OK ==="
