# ============================================================================
# Paths that SEARCH TOOLS must not index.
# ============================================================================
# Read by: ripgrep (rg), fd, fzf, VSCode's search, and any tool built on rg.
# NOT read by git, NOT read by CMake, NOT read by the compiler.
#
# Nothing here becomes untracked and nothing stops being compiled. A fresh
# clone builds exactly as before. This file only stops `grep` from returning
# 400 Nordic SDK hits before the first line of our own code.
#
# Escape hatch, any time you actually want to search vendor:
#     rg --no-ignore <pattern>
#
# Syntax is .gitignore syntax; `!` re-includes.
# ----------------------------------------------------------------------------

# --- Vendor: the Nordic SDK, 88 % of the tree on its own --------------------
ports/nrf52840/drivers/nRF5_SDK_17.0.2/

# --- Vendor: the two heavy third-party libraries ----------------------------
# CmBacktrace (734 files, incl. STM32 demos and Windows .exe tools) and ETL
# (338 files of headers) are 1 072 of the 1 109 files under libraries/.
# The other three -- prepass, littlefs, inplace_function -- total 36 files and
# are code we actually call into, so they stay fully searchable on purpose.
libraries/CmBacktrace/
libraries/etl-20.27.3/

# --- Vendor drop-ins sitting inside our own tree ----------------------------
# (the C++ wrappers next to them are ours and stay searchable)
ports/nrf52840/core/hardware/bma400/bma400.c
ports/nrf52840/core/hardware/bma400/bma400.h
ports/nrf52840/core/hardware/bma400/bma400_defs.h
ports/nrf52840/core/hardware/stc3117/stc311x_*
ports/nrf52840/core/hardware/stc3117/Generic_I2C.*
ports/nrf52840/core/memmang/heap_4.c
core/sm/tinyfsm.hpp

# --- Nordic config blobs (11 000+ lines each, generated by the SDK wizard) ---
ports/nrf52840/bsp/*/sdk_config.h
ports/nrf52840/bootloader/secure_bootloader/*/config/sdk_config.h

# --- Build output, reports, logs --------------------------------------------
build/
build_tests/
ports/nrf52840/build*/
tests/build/
tests/build_tests/
tests/reports/
tests/_deps/
*.map
*.hex
*.elf
*.bin
*.o
log.log
trackertests_report.html*
